{
  "name": "persistence-drizzle",
  "version": "0.1.3",
  "description": "A typed Drizzle ORM database over any SQLite driver: one lock serializing every statement, BEGIN IMMEDIATE transactions, drizzle-kit migrations at open, typed Preferences and a hardened export envelope. Drivers for Capacitor SQLite and node:sqlite.",
  "type": "module",
  "license": "MIT",
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/persistence-drizzle.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/persistence-drizzle/issues"
  },
  "homepage": "https://github.com/jbcom/persistence-drizzle#readme",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "sqlite",
    "sqlite-proxy",
    "capacitor",
    "capacitor-sqlite",
    "node-sqlite",
    "migrations",
    "drizzle-kit",
    "transactions",
    "persistence",
    "save-game",
    "game-dev"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@12.10.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./capacitor": {
      "import": {
        "types": "./dist/esm/capacitor.d.ts",
        "default": "./dist/esm/capacitor.js"
      },
      "require": {
        "types": "./dist/cjs/capacitor.d.cts",
        "default": "./dist/cjs/capacitor.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.cts",
        "default": "./dist/cjs/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "capacitor": [
        "./dist/esm/capacitor.d.ts"
      ],
      "node": [
        "./dist/esm/node.d.ts"
      ],
      "*": [
        "./dist/esm/index.d.ts"
      ]
    }
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "dist",
    "docs/API.md",
    "docs/ARCHITECTURE.md",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "examples:check": "node examples/basic.mjs && node examples/commonjs.cjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:docs": "markdownlint-cli2 README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md CHANGELOG.md AGENTS.md \"docs/**/*.md\" \"!docs/node_modules/**\" \"!docs/dist/**\" .github/PULL_REQUEST_TEMPLATE.md",
    "package:check": "publint && attw --pack . && node scripts/verify-package.mjs",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "verify": "pnpm run lint && pnpm run lint:docs && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run examples:check && pnpm run package:check && pnpm run smoke:consumer",
    "prepack": "node scripts/build.mjs",
    "docs:dev": "pnpm --filter persistence-drizzle-docs dev",
    "docs:build": "pnpm --filter persistence-drizzle-docs build",
    "docs:check": "pnpm --filter persistence-drizzle-docs check",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.2 <1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-orm": "0.45.3",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "markdownlint-cli2"
    ]
  }
}
