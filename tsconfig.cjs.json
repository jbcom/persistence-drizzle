{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist/cjs",
    "rootDir": "src",
    "verbatimModuleSyntax": false,
    "types": ["node"]
  },
  "include": ["src"]
}
